# CRITICO: Nombre único del proyecto Docker Compose
COMPOSE_PROJECT_NAME=traccarocra-shared

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO_AQUI
